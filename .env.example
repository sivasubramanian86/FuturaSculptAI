# ==============================================================================
# FuturaSculptAI Environment Configuration Template (.env.example)
# ==============================================================================
# In production on Google Cloud Run, authentication is managed automatically via
# the Gemini Enterprise Agent Platform with Application Default Credentials (ADC)
# and Workload Identity Federation (WIF) — NO static Gemini API keys or service
# account JSON files are required or allowed in cloud environments.
# ==============================================================================

# Application & Environment
ENVIRONMENT=development
DEBUG=false
APP_NAME="FuturaSculptAI API"
APP_VERSION="0.1.0"

# Multi-Tenant Context
DEFAULT_TENANT_ID=tenant-food-mfg-01

# Google Cloud Platform (ADC authenticated)
GCP_PROJECT_ID=genai-apac-2026-491004
GCP_REGION=asia-southeast1

# Model Gateway & Vertex AI
DEFAULT_MODEL_FAST=gemini-2.5-flash
DEFAULT_MODEL_PRO=gemini-2.5-pro
MOCK_LLM_MODE=true

# FinOps & Budgets
SESSION_COST_CAP_USD=2.00
BIGQUERY_MAX_BYTES_BILLED=1073741824
